# =================================================================
# Environment Configuration - AI Candidate Screening System
# =================================================================

# Server Configuration
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
ENVIRONMENT=development
LOG_LEVEL=INFO
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000"]

# Database & Storage
DATABASE_URL=sqlite:///./data/screening_system.db
CHROMA_PERSIST_DIR=./data/chroma_db
KNOWLEDGE_BASE_DIR=./data/knowledge_base
SAMPLE_RESUMES_DIR=./data/sample_resumes

# AI / ML Embedding Settings (Local Sentence-Transformers)
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
EMBEDDING_DEVICE=cpu

# LLM Gateway Configuration
# Options: "groq" (default, free), "gemini", or "openai"
LLM_PROVIDER=groq
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# Fallback / Alternative LLM Options
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# Interview Session Defaults
DEFAULT_TOTAL_QUESTIONS=5
MAX_TIME_PER_QUESTION_SECONDS=300
RAG_TOP_K_CHUNKS=3
RAG_SIMILARITY_THRESHOLD=0.55
